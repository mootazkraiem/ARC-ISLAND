# Copy this file to .env (same folder) and fill in your real key.
# .env is gitignored — it never gets committed. This file (.env.example)
# has no real secret in it, so it's safe to commit/share.
#
# Must keep the EXPO_PUBLIC_ prefix — that's what tells Expo's bundler to
# make this variable available to the app's JS at all (see
# src/assistant/providerConfig.ts for how it's read, and
# src/assistant/apiKeyStore.ts's resolveApiKey() for how it's used as a
# fallback under whatever you've saved manually in the app's Settings screen).
#
# Get a free key at https://openrouter.ai/keys
EXPO_PUBLIC_OPENROUTER_API_KEY=
