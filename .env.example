# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — it never gets committed. This file (.env.example)
# has no real secret in it, so it's safe to commit/share.
#
# Arc Island's assistant runs on Angelo, your own local AI core — not on a
# cloud service. There is no API key to buy and no account to create. What
# Arc Island needs is the address of Angelo's Core and the token Angelo
# minted for its clients.
#
# Both must keep the EXPO_PUBLIC_ prefix — that is what tells Expo's
# bundler to make a variable available to the app's JS at all. Both end up
# readable in the compiled bundle, which is acceptable here only because
# the token authorises nothing beyond this machine's loopback interface.
#
# See src/assistant/providerConfig.ts for how these are read.

# Where Angelo's Core is listening. Leave unset for the default below.
# Angelo binds to loopback ONLY and refuses to bind anywhere else, so a
# physical phone cannot reach it — see providerConfig.ts.
# EXPO_PUBLIC_ANGELO_CORE_URL=http://127.0.0.1:8770

# The Core token, so a dev build works without visiting Settings.
# Angelo prints its location on start; on Windows it is:
#   %LOCALAPPDATA%\Angelo\core.token
# Paste the file's contents here (Windows PowerShell):
#   Get-Content "$env:LOCALAPPDATA\Angelo\core.token"
EXPO_PUBLIC_ANGELO_CORE_TOKEN=
